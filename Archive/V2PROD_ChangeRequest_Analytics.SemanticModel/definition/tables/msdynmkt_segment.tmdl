table msdynmkt_segment
	lineageTag: 8d07a896-03d6-414a-acfa-f1cd49ed273a

	measure 'Total Subscribers' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('msdynmkt_contactpointconsent4'[msdynmkt_contactid]),
			    'msdynmkt_contactpointconsent4'[msdynmkt_consentstate] = "Opted In"
			)
			
			```
		lineageTag: 7a227c49-3942-4c36-b411-25546e6a8613

	measure 'Average Subscriptions per Contact' =
			
			AVERAGEX(
			    'msdynmkt_segment',
			    'msdynmkt_segment'[msdynmkt_membercount]
			)
		lineageTag: e1e014ed-0660-4e8b-8ca5-b03b6d07b9fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

