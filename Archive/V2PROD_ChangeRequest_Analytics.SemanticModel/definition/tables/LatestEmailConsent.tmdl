table LatestEmailConsent
	lineageTag: c3967bab-f58a-4e36-be40-73c087eb8ff1

	measure 'Total Email Subscribers' =
			
			CALCULATE(
			    DISTINCTCOUNT(LatestEmailConsent[msdynmkt_contactpointvalue]),
			    LatestEmailConsent[msdynmkt_value_display] = "Opted In"
			)
		formatString: 0
		lineageTag: 25110b30-0ef4-4039-b93e-1cb50ce9f3ca

	measure 'Total Email Opted Out' =
			
			CALCULATE(
			    DISTINCTCOUNT(LatestEmailConsent[msdynmkt_contactpointvalue]),
			    LatestEmailConsent[msdynmkt_value_display] = "Opted Out"
			)
		formatString: 0
		lineageTag: db7712d7-3c9f-407b-ae5e-53f2fe124aaa

	measure 'Total Email Not Set' =
			
			CALCULATE(
			    DISTINCTCOUNT(LatestEmailConsent[msdynmkt_contactpointvalue]),
			    LatestEmailConsent[msdynmkt_value_display] = "Not Set"
			)
		formatString: 0
		lineageTag: 035fcddc-e241-41e9-b29b-5afa46ff2837

