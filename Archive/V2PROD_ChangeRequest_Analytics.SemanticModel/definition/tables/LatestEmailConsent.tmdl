	column ConsentRank
		formatString: 0
		lineageTag: 293b23eb-620a-4401-b571-3d53678534c4
		summarizeBy: sum
		isNameInferred
		sourceColumn: [ConsentRank]

		annotation SummarizationSetBy = Automatic

	partition LatestEmailConsent = calculated
		mode: import
		source =
				
				VAR Base =
				    FILTER(
				        'msdynmkt_contactpointconsent4',
				        'msdynmkt_contactpointconsent4'[msdynmkt_contactpointtype_display] = "Email"
				            && NOT ISBLANK('msdynmkt_contactpointconsent4'[msdynmkt_contactpointvalue])
				    )
				VAR Ranked =
				    ADDCOLUMNS(
				        Base,
				        "ConsentRank",
				            RANKX(
				                FILTER(
				                    Base,
				                    'msdynmkt_contactpointconsent4'[msdynmkt_contactpointvalue]
				                        = EARLIER('msdynmkt_contactpointconsent4'[msdynmkt_contactpointvalue])
				                ),
				                'msdynmkt_contactpointconsent4'[createdon],
				                ,
				                DESC,
				                DENSE
				            )
				    )
				RETURN
				    FILTER(Ranked, [ConsentRank] = 1)

	annotation PBI_Id = 40ee33363a11429ca2a9eb63e4ee8395

