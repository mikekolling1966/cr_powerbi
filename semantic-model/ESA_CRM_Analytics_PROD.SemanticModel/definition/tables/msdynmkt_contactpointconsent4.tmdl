table msdynmkt_contactpointconsent4
	lineageTag: 03639e52-6203-4d0b-a434-8c67cab3a2c8
	sourceLineageTag: [dbo].[msdynmkt_contactpointconsent4]

	measure 'Subscriber Count' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(DISTINCTCOUNT(msdynmkt_contactpointconsent4[msdynmkt_contactpointvalue]), msdynmkt_contactpointconsent4[msdynmkt_value] = 534120001, NOT(ISBLANK(msdynmkt_contactpointconsent4[msdynmkt_topicid])), msdynmkt_contactpointconsent4[createdon] >= MinDate, msdynmkt_contactpointconsent4[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: a1490f2e-cbac-4774-ac72-26310f623bb9

	measure 'Total Email Not Set' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(DISTINCTCOUNT(msdynmkt_contactpointconsent4[msdynmkt_contactpointvalue]), msdynmkt_contactpointconsent4[msdynmkt_contactpointtype] = 534120000, ISBLANK(msdynmkt_contactpointconsent4[msdynmkt_value]), msdynmkt_contactpointconsent4[createdon] >= MinDate, msdynmkt_contactpointconsent4[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 9a3db0ef-709c-4d03-9eb3-6eb3c61d9be0

	measure 'Total Email Opted Out' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(DISTINCTCOUNT(msdynmkt_contactpointconsent4[msdynmkt_contactpointvalue]), msdynmkt_contactpointconsent4[msdynmkt_contactpointtype] = 534120000, msdynmkt_contactpointconsent4[msdynmkt_value] = 534120002, msdynmkt_contactpointconsent4[createdon] >= MinDate, msdynmkt_contactpointconsent4[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 0844b166-7c98-4f87-a35c-16d90ef534c3

	measure 'Total Email Subscribers' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(DISTINCTCOUNT(msdynmkt_contactpointconsent4[msdynmkt_contactpointvalue]), msdynmkt_contactpointconsent4[msdynmkt_contactpointtype] = 534120000, msdynmkt_contactpointconsent4[msdynmkt_value] = 534120001, msdynmkt_contactpointconsent4[createdon] >= MinDate, msdynmkt_contactpointconsent4[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 38a0235c-78c3-4710-b92f-60443e5cb541

