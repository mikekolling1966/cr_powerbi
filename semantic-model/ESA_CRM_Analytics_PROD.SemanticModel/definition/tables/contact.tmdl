table contact
	lineageTag: 38d0ecd8-1143-4cae-8c02-2409db9b1845
	sourceLineageTag: [dbo].[contact]

	measure 'Total Contacts' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(contact), contact[createdon] >= MinDate, contact[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: a91f27be-f963-4ddf-b225-73d9d53bdc96

	measure 'Number of Duplicate Contacts' = VAR EmailCounts = ADDCOLUMNS(SUMMARIZE(contact, contact[emailaddress1]), "ContactCount", CALCULATE(COUNTROWS(contact))) RETURN SUMX(FILTER(EmailCounts, NOT ISBLANK(contact[emailaddress1]) && [ContactCount] > 1), [ContactCount] - 1)
		formatString: 0
		lineageTag: fd397fd9-701d-4c2b-be61-72480c5840fc

	measure 'Consent - GDPR Do Not Track' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(contact), contact[msgdpr_donottrack] = TRUE(), contact[createdon] >= MinDate, contact[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 976bbc45-50e7-4bcb-94cb-9c2e8efdab41

	measure 'Consent - No Bulk Email' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(contact), contact[donotbulkemail] = TRUE(), contact[createdon] >= MinDate, contact[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 05de435b-e847-460b-b7a9-da21bb8d4c3b

	measure 'Consent - No Bulk Postal Mail' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(contact), contact[donotbulkpostalmail] = TRUE(), contact[createdon] >= MinDate, contact[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: bd481a0a-c0de-4204-9991-f88da32d83bc

	measure 'Consent - No Email' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(contact), contact[donotemail] = TRUE(), contact[createdon] >= MinDate, contact[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: eeaa85b4-174a-404f-ab3f-9ca37b458957

	measure 'Consent - No Phone' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(contact), contact[donotphone] = TRUE(), contact[createdon] >= MinDate, contact[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 76ecc6bf-8fff-49fe-a28c-ed7ea331f92c

	measure 'Consent - No Postal Mail' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(contact), contact[donotpostalmail] = TRUE(), contact[createdon] >= MinDate, contact[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: d274e6d8-01f8-4d9b-86dc-a66c1541c4ca

