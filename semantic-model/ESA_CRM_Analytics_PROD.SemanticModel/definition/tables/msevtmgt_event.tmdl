table msevtmgt_event
	lineageTag: e266c5a2-a175-4b88-983e-4aa0bb1d5959
	sourceLineageTag: [dbo].[msevtmgt_event]

	measure 'Total EVents' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(msevtmgt_event), msevtmgt_event[createdon] >= MinDate, msevtmgt_event[createdon] < MaxDate + 1)
