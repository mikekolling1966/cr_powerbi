table msdynmkt_email
	lineageTag: 686bf61e-ae5f-42e5-b3bd-d8e4ef58010d
	sourceLineageTag: [dbo].[msdynmkt_email]

	measure 'Total Marketing EMails' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(msdynmkt_email), msdynmkt_email[createdon] >= MinDate, msdynmkt_email[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 19ac99c8-84e9-4538-985b-c84799415664

	measure 'Total Newsletters 2' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(msdynmkt_email), FILTER(msdynmkt_email, SEARCH("Newsletter", msdynmkt_email[msdynmkt_subject], 1, 0) > 0), msdynmkt_email[createdon] >= MinDate, msdynmkt_email[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: fc409341-dcaf-4f3d-9595-e9f6d55cff44

