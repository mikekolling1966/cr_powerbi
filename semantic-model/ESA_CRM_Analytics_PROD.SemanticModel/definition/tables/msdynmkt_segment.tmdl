table msdynmkt_segment
	lineageTag: 34bf3b01-1ab4-4d9e-8c4d-f10780831c55
	sourceLineageTag: [dbo].[msdynmkt_segment]

	measure 'Average Subscriptions per Contact' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(AVERAGEX(msdynmkt_segment, msdynmkt_segment[msdynmkt_membercount]), msdynmkt_segment[createdon] >= MinDate, msdynmkt_segment[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 9fad39e0-5aaf-40fb-b6f3-462c807a8255

