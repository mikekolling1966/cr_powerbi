table crm_health_snapshot
	lineageTag: fc9ef545-36f1-40fe-b7d8-36c12e5fe942
	sourceLineageTag: [dbo].[crm_health_snapshot]

	measure 'Health Active Users Display' = VAR v = [Health Active Users] RETURN IF(ISBLANK(v), BLANK(), FORMAT(v, "0"))
		formatString: ""

	measure 'Health Enabled System Users Display' = VAR v = [Health Enabled System Users] RETURN IF(ISBLANK(v), BLANK(), FORMAT(v, "0"))
		formatString: ""

	measure 'Health Last Refreshed Display' = VAR v = [Health Last Refreshed] RETURN IF(ISBLANK(v), BLANK(), FORMAT(v, "dd/MM/yyyy"))
		formatString: ""

	measure 'Health Active Users' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(MAX(crm_health_snapshot[active_users_current]), TREATAS(VALUES(Environment[Environment]), crm_health_snapshot[environment]), crm_health_snapshot[snapshot_date] >= MinDate, crm_health_snapshot[snapshot_date] < MaxDate + 1)
		formatString: 0

	measure 'Health Active Users Max' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(MAX(crm_health_snapshot[active_users_max]), TREATAS(VALUES(Environment[Environment]), crm_health_snapshot[environment]), crm_health_snapshot[snapshot_date] >= MinDate, crm_health_snapshot[snapshot_date] < MaxDate + 1)
		formatString: 0

	measure 'Health Failed System Jobs' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(MAX(crm_health_snapshot[failed_system_jobs]), TREATAS(VALUES(Environment[Environment]), crm_health_snapshot[environment]), crm_health_snapshot[snapshot_date] >= MinDate, crm_health_snapshot[snapshot_date] < MaxDate + 1)
		formatString: 0

	measure 'Health Custom Entities' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(MAX(crm_health_snapshot[custom_entities_current]), TREATAS(VALUES(Environment[Environment]), crm_health_snapshot[environment]), crm_health_snapshot[snapshot_date] >= MinDate, crm_health_snapshot[snapshot_date] < MaxDate + 1)
		formatString: 0

	measure 'Health Custom Entities Max' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(MAX(crm_health_snapshot[custom_entities_max]), TREATAS(VALUES(Environment[Environment]), crm_health_snapshot[environment]), crm_health_snapshot[snapshot_date] >= MinDate, crm_health_snapshot[snapshot_date] < MaxDate + 1)
		formatString: 0

	measure 'Health Enabled System Users' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(MAX(crm_health_snapshot[enabled_users]), TREATAS(VALUES(Environment[Environment]), crm_health_snapshot[environment]), crm_health_snapshot[snapshot_date] >= MinDate, crm_health_snapshot[snapshot_date] < MaxDate + 1)
		formatString: 0

	measure 'Health Last Refreshed' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(MAX(crm_health_snapshot[snapshot_date]), TREATAS(VALUES(Environment[Environment]), crm_health_snapshot[environment]), crm_health_snapshot[snapshot_date] >= MinDate, crm_health_snapshot[snapshot_date] < MaxDate + 1)
		formatString: dd/MM/yyyy

	measure 'Alert Threshold' = 80
		formatString: 0
		lineageTag: 1a17271e-094b-46d9-85d7-02c1f60a59c3

	measure 'Failed Jobs Max' = 100
		formatString: 0
		lineageTag: d15b2918-1ec4-4b0a-8c9b-fdc1ae972213

