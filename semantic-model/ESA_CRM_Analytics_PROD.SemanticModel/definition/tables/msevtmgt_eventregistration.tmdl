table msevtmgt_eventregistration
	lineageTag: a6079dd5-231b-41cd-8748-d7eca9c5f857
	sourceLineageTag: [dbo].[msevtmgt_eventregistration]

	measure 'Total Event Registrations' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(msevtmgt_eventregistration), msevtmgt_eventregistration[createdon] >= MinDate, msevtmgt_eventregistration[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 9e851196-c90a-41c6-90c5-8e61b2991f29

