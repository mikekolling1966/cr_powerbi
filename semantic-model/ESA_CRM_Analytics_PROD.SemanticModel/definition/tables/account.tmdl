	measure 'Total Accounts' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(account), account[createdon] >= MinDate, account[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: 0189a6aa-21d9-4cb5-b599-929e9166d550

