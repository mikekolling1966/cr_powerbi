table msdynmkt_marketingform
	lineageTag: e543e2d5-473f-4e6e-8003-5cd23053d66f
	sourceLineageTag: [dbo].[msdynmkt_marketingform]

	measure 'Total Marketing Forms' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(msdynmkt_marketingform), msdynmkt_marketingform[createdon] >= MinDate, msdynmkt_marketingform[createdon] < MaxDate + 1)
