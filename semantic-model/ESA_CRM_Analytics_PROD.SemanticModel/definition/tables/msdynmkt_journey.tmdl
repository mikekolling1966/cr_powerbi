table msdynmkt_journey
	lineageTag: 8dead0ad-1c72-4666-89ca-5feeaa5ff9d9
	sourceLineageTag: [dbo].[msdynmkt_journey]

	measure 'TotalJourneys' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(msdynmkt_journey), msdynmkt_journey[createdon] >= MinDate, msdynmkt_journey[createdon] < MaxDate + 1)
		formatString: 0
		lineageTag: b9d0fac0-a356-481d-ac89-25a7f3d5557a

