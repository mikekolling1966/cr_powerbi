table msfp_surveyresponse
	lineageTag: 4c999391-a320-41a0-ab37-b2e9206e4189
	sourceLineageTag: [dbo].[msfp_surveyresponse]

	measure 'Total Customer Voice' = VAR MinDate = MIN('DateTable'[Date]) VAR MaxDate = MAX('DateTable'[Date]) RETURN CALCULATE(COUNTROWS(msfp_surveyresponse), msfp_surveyresponse[msfp_submitdate] >= MinDate, msfp_surveyresponse[msfp_submitdate] < MaxDate + 1)
