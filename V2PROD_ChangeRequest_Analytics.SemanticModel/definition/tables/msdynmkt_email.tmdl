table msdynmkt_email
	lineageTag: 2b59e9c8-ceaa-49d6-8e53-65b638a72f7c

	measure 'Total Marketing EMails' = COUNTROWS('msdynmkt_email')
		formatString: 0
		lineageTag: 62741318-5078-4d91-8ce7-7286d3d45cd5

	measure 'Total Newsletters 2' =
			
			COUNTROWS(
			    FILTER(
			        ALL('msdynmkt_email'),
			        SEARCH("Newsletter", 'msdynmkt_email'[msdynmkt_subject], 1, 0) > 0
			    )
			)
		formatString: 0
		lineageTag: 5f628222-594a-44e1-ae9e-6de376635917

